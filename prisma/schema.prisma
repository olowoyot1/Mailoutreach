generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProspectStatus {
  NEW
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  BOUNCED
  UNSUBSCRIBED
}

enum EmailStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  BOUNCED
  REPLIED
}

model Prospect {
  id          String            @id @default(cuid())
  companyName String
  contactName String?
  email       String?
  website     String?
  country     String            @default("UAE")
  notes       String?
  status      ProspectStatus    @default(NEW)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  emails      EmailLog[]
  campaigns   CampaignProspect[]

  @@index([status])
}

model Campaign {
  id          String             @id @default(cuid())
  name        String
  description String?            @db.Text
  subject     String
  body        String             @db.Text
  status      String             @default("DRAFT")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  prospects   CampaignProspect[]
  emails      EmailLog[]

  @@index([status, createdAt])
}

model CampaignProspect {
  id         String   @id @default(cuid())
  campaignId String
  prospectId String
  addedAt    DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@unique([campaignId, prospectId])
  @@index([prospectId])
}

model EmailLog {
  id           String      @id @default(cuid())
  prospectId   String
  prospect     Prospect    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  subject      String
  body         String      @db.Text
  status       EmailStatus @default(DRAFT)
  sequenceStep Int         @default(0)
  scheduledAt  DateTime?
  sentAt       DateTime?
  messageId    String?
  error        String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([status, scheduledAt])
  @@index([campaignId])
}

model Suppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now())
}
